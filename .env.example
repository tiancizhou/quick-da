# Docker Compose configuration.
# Copy this file to .env and replace values for your environment.
# Do not commit .env.

SERVER_PORT=8000
GENERATION_MAX_CONCURRENT=10

# PostgreSQL settings used by docker-compose.yml.
POSTGRES_DB=quickapp
POSTGRES_USER=quickapp
POSTGRES_PASSWORD=replace-with-a-strong-password

# OpenAI-compatible LLM settings.
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://example.com/v1
LLM_MODEL=replace-with-model-name
# Set to false for LLM gateways that report stream errors such as client_gone.
LLM_STREAMING=false
